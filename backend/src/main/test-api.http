@baseUrl = http://localhost:8080
@token = {{token}}

### 1. 测试注册 - 正常情况
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "username": "neurotest",
  "password": "123456"
}

### 2. 测试注册 - 重复注册 (应该报错 400)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "username": "neurotest",
  "password": "123456"
}

### 3. 测试登录 - 密码错误 (应该报错 400)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "neurotest",
  "password": "wrongpwd"
}

### 4. 测试登录 - 成功 (返回 Token，自动存为全局变量)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "neurotest",
  "password": "123456"
}

> {%
    client.log("登录成功，响应体：");
    client.log(response.body);
    if(response.body.data && response.body.data.accessToken) {
        client.global.set("token", response.body.data.accessToken);
        client.global.set("refresh_token", response.body.data.refreshToken);
        client.log("已自动捕获 accessToken 和 refreshToken");
    }
%}

### 5. 🌟 测试无感刷新 Token
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{refresh_token}}"
}

> {%
    client.log("刷新 Token 成功，新 Token：");
    if(response.body.data) {
        client.global.set("token", response.body.data);
        client.log("已自动更新 accessToken");
    }
%}

### 6. 【未登录】尝试创建笔记 (应该被拦截报错 401)
POST {{baseUrl}}/api/notes
Content-Type: application/json

{
  "title": "测试笔记",
  "content": "这是内容"
}

### 7. 新增笔记
POST {{baseUrl}}/api/notes
Content-Type: application/json
satoken: {{token}}

{
  "title": "我的第一篇神经笔记",
  "content": "Sa-Token 和 MyBatis-Plus 太好用了！"
}

### 8. 查询笔记
GET {{baseUrl}}/api/notes
satoken: {{token}}

### 9. 修改笔记 (改 id=17)
PUT {{baseUrl}}/api/notes/17
Content-Type: application/json
satoken: {{token}}

{
  "title": "Spring Boot 入门，特别是版本回滚",
  "content": "今天学了 Spring 的 JSONB 查询...,e,还有回滚",
  "tags": ["Java", "Spring"],
  "outlineJson": [{"l":1,"t":"Spring Boot 核心特性"},{"l":2,"t":"自动配置原理"}]
}

### 10. 删除笔记 (软删除 id=20)
DELETE {{baseUrl}}/api/notes/20
satoken: {{token}}

### 11. 分页查询笔记 (查第1页，每页2条)
GET {{baseUrl}}/api/notes?pageNum=1&pageSize=2
satoken: {{token}}

### 12. 创建根文件夹
POST {{baseUrl}}/api/folders
Content-Type: application/json
satoken: {{token}}

{
  "name": "Java学习",
  "parentId": null,
  "sortOrder": 1
}

### 13. 获取所有文件夹树 (看看有没有刚建的)
GET {{baseUrl}}/api/folders/tree
satoken: {{token}}

### 14. 修改文件夹 (把名字改掉，假设 id=1)
PUT {{baseUrl}}/api/folders/1
Content-Type: application/json
satoken: {{token}}

{
  "name": "Java进阶学习"
}

### 15. 删除空文件夹 (假设 id=1)
DELETE {{baseUrl}}/api/folders/1
satoken: {{token}}

### 16. 高级搜索：查出带有 "Spring" 标签的笔记
GET {{baseUrl}}/api/notes/search?tag=Spring
satoken: {{token}}

### 17. 高级搜索：查出大纲里包含 "Spring Boot" 关键词的笔记
GET {{baseUrl}}/api/notes/search?outlineKeyword=Spring Boot
satoken: {{token}}

### 18. 高级搜索：双管齐下（既有 Java 标签，大纲又包含 Spring）
GET {{baseUrl}}/api/notes/search?tag=Java&outlineKeyword=Spring
satoken: {{token}}

### 19. 获取单篇笔记详情 (假设 id=17)
GET {{baseUrl}}/api/notes/17
satoken: {{token}}

### 20. 更新笔记 - 内容未改变 (Hash相同，应该秒返回，不触发DB写)
PUT {{baseUrl}}/api/notes/17
Content-Type: application/json
satoken: {{token}}

{
  "title": "Spring Boot 入门",
  "content": "今天学了 Spring 的 JSONB 查询...",
  "tags": ["Java", "Spring"],
  "outlineJson": [{"l":1,"t":"Spring Boot 核心特性"},{"l":2,"t":"自动配置原理"}],
  "contentHash": "你数据库里存的hash值，如果为空就传空字符串"
}

### 21. 获取文件夹下的笔记列表 (假设 folderId=1，返回结果里应该没有 content 字段)
GET {{baseUrl}}/api/notes/by-folder/1?page=1&size=20
satoken: {{token}}

### 22. 制造版本1：修改笔记 (改变内容和 Hash，触发存档)
PUT {{baseUrl}}/api/notes/17
Content-Type: application/json
satoken: {{token}}

{
  "title": "版本1：学习 Spring Boot",
  "content": "这是第一次修改的内容，关于Spring的自动配置。",
  "tags": ["Java", "Spring"],
  "outlineJson": [{"l":1,"t":"Spring Boot 入门"}],
  "contentHash": "hash_v1"
}

### 23. 制造版本2：再次修改笔记 (改变内容和 Hash，再触发一次存档)
PUT {{baseUrl}}/api/notes/17
Content-Type: application/json
satoken: {{token}}

{
  "title": "版本2：学习 MyBatis-Plus",
  "content": "这是第二次修改的内容，MP的分页真好用！",
  "tags": ["Java", "MyBatis"],
  "outlineJson": [{"l":1,"t":"MyBatis-Plus 核心逻辑"}],
  "contentHash": "hash_v2"
}

### 24. 制造版本3：第三次修改 (当前最新版本)
PUT {{baseUrl}}/api/notes/17
Content-Type: application/json
satoken: {{token}}

{
  "title": "版本3：PostgreSQL 降维打击",
  "content": "这是第三次修改，PG的JSONB简直是神！",
  "tags": ["Java", "PG"],
  "outlineJson": [{"l":1,"t":"PG 高级查询"}],
  "contentHash": "hash_v3"
}

### 25. 🌟 查询笔记 17 的历史版本列表
GET {{baseUrl}}/api/notes/17/versions
satoken: {{token}}

> {%
    client.log("历史版本列表：");
    client.log(response.body);
    if(response.body.data && response.body.data.length > 0) {
        client.global.set("rollback_version_id", response.body.data[0].id);
        client.log("自动选中最新历史版本 ID: " + response.body.data[0].id + " 用于回滚");
    }
%}

### 26. 🌟 执行回滚 (回滚到刚才查到的某个 version_id)
POST {{baseUrl}}/api/notes/17/rollback/{{rollback_version_id}}
satoken: {{token}}

### 27. 验证回滚结果：查看笔记详情 (内容应该变回历史版本了，且 content_hash 被清空)
GET {{baseUrl}}/api/notes/17
satoken: {{token}}

### 28. 验证回滚是否产生了新版本：再次查询版本列表 (应该多了一个"回滚前自动存档")
GET {{baseUrl}}/api/notes/17/versions
satoken: {{token}}

### 29. 手动建立双链 (假设 16 和 17 互相引用)
POST {{baseUrl}}/api/notes/relations
Content-Type: application/json
satoken: {{token}}

{
  "noteIdA": 16,
  "noteIdB": 17,
  "relationType": "REFERENCE"
}

### 30. 🌟 获取全局图谱数据 (见证奇迹的时刻！)
GET {{baseUrl}}/api/graph/global
satoken: {{token}}

### 31. 获取今日待复习卡片
GET {{baseUrl}}/api/flashcards/due
satoken: {{token}}

### 32. 🌟 提交复习结果 (模拟前端 Wasm 算好的新状态)
POST {{baseUrl}}/api/flashcards/batch-update
Content-Type: application/json
satoken: {{token}}

[
  {
    "id": 1,
    "rating": 4,
    "new_state": {
      "interval": 1,
      "repetition": 1,
      "efactor": 2.6,
      "next_review_date": "2026-05-10"
    }
  }
]

### 33. 🌟 获取知识分布雷达图 (PG 数组展开绝杀)
GET {{baseUrl}}/api/stats/tag-distribution
satoken: {{token}}

### 34. 🌟 获取学习热力图 (默认今年)
GET {{baseUrl}}/api/stats/activity-heatmap
satoken: {{token}}

### 35. 测试 Tag 查询 (搜 Java，应该查出 16 和 17 两条)
GET {{baseUrl}}/api/notes/search?tag=Java
satoken: {{token}}

### 36. 🌟 测试大纲精确查询 (搜 "PG 高级查询"，命中 GIN 索引，应该只查出 17)
GET {{baseUrl}}/api/notes/search?outlineKeyword=PG 高级查询
satoken: {{token}}

### 37. 🌟 测试大纲模糊查询失败 (搜 "查询"，因为 @> 是精确包含，不再支持 LIKE 模糊，应该查出 0 条)
GET {{baseUrl}}/api/notes/search?outlineKeyword=查询
satoken: {{token}}

### 38. 测试组合查询 (搜标签 PG 且大纲包含 "PG 高级查询"，应该只查出 17)
GET {{baseUrl}}/api/notes/search?tag=PG&outlineKeyword=PG 高级查询
satoken: {{token}}
